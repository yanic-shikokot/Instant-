{
  "name": "fieldinspect-pro",
  "productName": "FieldInspect Pro",
  "private": true,
  "version": "1.8.8",
  "description": "Commercial field inspection reporting desktop application.",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Yanic Shikokot",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=./",
    "preview": "vite preview",
    "clean": "rimraf dist release",
    "lint": "tsc --noEmit",
    "electron:dev": "npm run build && electron .",
    "cap:sync": "cap sync",
    "cap:build": "npm run build && cap sync",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "dist:dir": "npm run build && electron-builder --win --dir --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.117.2",
    "dotenv": "^17.2.3",
    "electron-updater": "6.8.10",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide": "^1.52.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "autoprefixer": "^10.4.21",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "rimraf": "^6.0.1"
  },
  "build": {
    "appId": "ke.yanic.fieldinspectpro",
    "productName": "FieldInspect Pro",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "FieldInspect-Pro-Setup-${version}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "FieldInspectPro"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "FieldInspect Pro",
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "yanic-shikokot",
      "repo": "Instant-",
      "releaseType": "release",
      "publishAutoUpdate": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yanic-shikokot/Instant-.git"
  }
}
